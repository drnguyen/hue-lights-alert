# Copy to .env and edit. docker compose reads this file automatically.

# REQUIRED: token used to log in to the admin page (/admin).
ADMIN_TOKEN=change-me-to-a-long-random-secret

# Optional: key used to sign admin session cookies. If empty, a random key is
# generated at each start, which logs every admin out on restart.
SESSION_SECRET=

# Optional: admin session lifetime in hours (default 12).
SESSION_TTL_HOURS=12

# Optional: how long mDNS discovery listens, in seconds (default 5).
DISCOVERY_TIMEOUT_SECONDS=20

# Optional: port the service listens on (inside the container and on the host
# with the default docker-compose.yml). Default 8000.
PORT=8000

# HTTPS is on by default with a self-signed certificate generated on first
# start into ./data/certs (kept across restarts). Set to false for plain HTTP.
TLS_ENABLED=true

# Optional: comma-separated DNS names / IPs to put in the certificate
# (Subject Alternative Names). Default: localhost,127.0.0.1,<container hostname>.
# Add the address other apps use, e.g. TLS_HOSTNAMES=localhost,127.0.0.1,hue.local,192.168.1.50
TLS_HOSTNAMES=

# Optional: validity of the generated certificate in days (default 3650).
TLS_CERT_DAYS=3650

# Optional: set to true for ONE start to replace the generated certificate
# (e.g. after changing TLS_HOSTNAMES), then set back to false.
TLS_REGENERATE=false

# Optional: bring your own certificate instead (both required, mounted read-only).
# TLS_CERT_FILE=/certs/server.crt
# TLS_KEY_FILE=/certs/server.key
